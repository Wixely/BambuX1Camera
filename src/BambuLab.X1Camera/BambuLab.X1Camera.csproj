<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BambuLab.X1Camera</AssemblyName>
    <RootNamespace>BambuLab.X1Camera</RootNamespace>
    <Description>Managed .NET transport for Bambu Lab X1-series LAN camera streams.</Description>
    <PackageId>BambuLab.X1Camera</PackageId>
    <Version>0.1.0-alpha.3</Version>
    <Authors>Wixely</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Wixely/BambuX1Camera</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Wixely/BambuX1Camera.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>bambu-lab;bambu;x1;camera;rtsp;rtp;h264</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
